<view class="page">
  <view class="hero compact-hero opportunity-hero">
    <text class="hero-title">机会大厅</text>
    <text class="hero-subtitle">就业、实习、实践、志愿、创业项目一站对接</text>
  </view>

  <view class="section">
    <view class="segmented">
      <view wx:for="{{tabs}}" wx:key="*this" data-tab="{{item}}" bindtap="selectTab" class="segment {{current === item ? 'active' : ''}}">{{item}}</view>
    </view>
  </view>

  <view class="section">
    <view class="card opportunity-card" wx:for="{{opportunities}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="opportunity-top">
        <text class="card-title">{{item.title}}</text>
        <text class="tag tag-orange">{{item.type}}</text>
      </view>
      <text class="muted">{{item.unit}}</text>
      <view class="info-grid">
        <view><text class="info-label">地点</text><text class="info-value">{{item.location}}</text></view>
        <view><text class="info-label">补贴</text><text class="info-value">{{item.pay}}</text></view>
        <view><text class="info-label">要求</text><text class="info-value">{{item.education}}</text></view>
        <view><text class="info-label">截止</text><text class="info-value">{{item.deadline}}</text></view>
      </view>
      <view class="tag-row">
        <text class="tag" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
      </view>
      <button class="primary-btn">立即报名</button>
    </view>
  </view>
</view>
