.opportunity-hero {
  background: linear-gradient(135deg, #21a67a 0%, #2f80ed 100%);
}

.opportunity-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.opportunity-top .tag {
  flex: 0 0 auto;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin: 20rpx 0;
}

.info-grid > view {
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f6faff;
}

.info-label {
  display: block;
  margin-bottom: 6rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.info-value {
  display: block;
  color: #111827;
  font-size: 24rpx;
  font-weight: 700;
}

.opportunity-card .primary-btn {
  margin-top: 20rpx;
  width: 100%;
}
