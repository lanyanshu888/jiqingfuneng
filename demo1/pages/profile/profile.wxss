.result-card {
  margin-top: 24rpx;
}

.path-box {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f6faff;
  color: #374151;
  font-size: 25rpx;
}

.path-box text:first-child {
  color: #111827;
  font-weight: 800;
}

.form-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff;
}

.picker-text {
  display: flex;
  align-items: center;
  color: #111827;
}

.check-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.check-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 74rpx;
  padding: 0 14rpx;
  border: 1rpx solid #d9e4f2;
  border-radius: 12rpx;
  background: #f9fbfe;
  font-size: 24rpx;
}

.submit-btn {
  width: 100%;
  margin-top: 12rpx;
}
