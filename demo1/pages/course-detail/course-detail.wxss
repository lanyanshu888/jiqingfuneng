@import "../policy-detail/policy-detail.wxss";

.video-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 330rpx;
  margin: 22rpx 0;
  border-radius: 18rpx;
  background: #111827;
  color: #fff;
  text-align: center;
  font-size: 34rpx;
  font-weight: 800;
}

.video-box .muted {
  max-width: 520rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  font-weight: 400;
}
