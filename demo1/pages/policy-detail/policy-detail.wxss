.detail-head {
  padding: 30rpx 26rpx;
  border-radius: 20rpx;
  background: #fff;
}

.detail-title {
  display: block;
  color: #111827;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.35;
}

.detail-text {
  display: block;
  color: #374151;
  font-size: 27rpx;
  line-height: 1.65;
}

.list-line {
  margin-top: 12rpx;
  color: #374151;
  font-size: 26rpx;
  line-height: 1.55;
}

.flow {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.flow-step {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #374151;
}

.flow-num {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #2f80ed;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
}

.fixed-action {
  width: 100%;
  margin-top: 12rpx;
}
