.launch-page {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  justify-content: space-between;
  padding: 72rpx 44rpx 64rpx;
  background: linear-gradient(160deg, #2f80ed 0%, #21a67a 64%, #f2994a 100%);
  color: #fff;
}

.brand-block {
  padding-top: 42rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 34rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 58rpx;
  font-weight: 900;
}

.launch-title {
  display: block;
  font-size: 64rpx;
  font-weight: 900;
}

.launch-subtitle {
  display: block;
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.launch-line {
  display: block;
  margin-top: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 25rpx;
  line-height: 1.6;
}

.launch-panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 26rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.14);
}

.panel-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.panel-row text {
  padding: 20rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #1f2937;
  text-align: center;
  font-size: 25rpx;
  font-weight: 800;
}

.launch-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
}

.launch-actions .primary-btn,
.launch-actions .secondary-btn {
  width: 100%;
}

.launch-actions .secondary-btn {
  border-color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
}
