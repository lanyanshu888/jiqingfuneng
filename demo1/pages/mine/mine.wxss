.mine-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #fff;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2f80ed, #21a67a);
  color: #fff;
  font-size: 38rpx;
  font-weight: 800;
}

.mine-info {
  flex: 1;
}

.mine-name {
  display: block;
  margin-bottom: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.points-card {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 26rpx;
  border-radius: 18rpx;
  background: #fff4e7;
}

.points {
  display: block;
  color: #e6761b;
  font-size: 52rpx;
  font-weight: 900;
}

.points-rules {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx 18rpx;
  color: #8a4a12;
  font-size: 22rpx;
}

.summary-card {
  min-width: 0;
  padding: 24rpx 12rpx;
  border-radius: 16rpx;
  background: #fff;
  text-align: center;
}

.summary-num {
  display: block;
  margin-bottom: 8rpx;
  color: #2f80ed;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
  word-break: break-all;
}

.menu-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  color: #111827;
  font-size: 29rpx;
  font-weight: 700;
}

.menu-arrow {
  color: #9ca3af;
  font-size: 40rpx;
}

.service-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff;
}

.ghost-logout {
  margin-top: 18rpx;
  color: #e6761b;
  font-size: 25rpx;
  text-align: left;
}
