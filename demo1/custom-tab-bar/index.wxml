<view class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tabbar-item {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tabbar-icon">{{item.icon}}</view>
    <text class="tabbar-text">{{item.text}}</text>
  </view>
</view>
